{
  "name": "cuewise-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cuewise monorepo — browser extension, macOS app, cloud-sync API and website",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release:prepare": "pnpm version && pnpm build",
    "release:extension": "pnpm --filter @cuewise/browser-extension build:store",
    "publish:chrome": "node scripts/publish-chrome.mts",
    "release:status": "node scripts/release-status.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "^9.1.7",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  }
}
