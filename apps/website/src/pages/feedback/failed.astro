---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';
---

<Base title="Request not sent - Cuewise" description="Your feature request did not reach us.">
  <meta name="robots" content="noindex" slot="head" />
  <main>
    <section class="page-hero">
      <div class="wrap">
        <h1>That didn't send.</h1>
        <p class="hero-sub">
          Your request did not reach us, so it is worth another go — or email it straight to
          <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a> and it will land either way.
        </p>
        <div class="outcome-links">
          <a class="btn btn-primary" href="/feedback/">Try again</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .outcome-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
</style>
