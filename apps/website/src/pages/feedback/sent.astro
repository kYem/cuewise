---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';
---

<Base title="Request received - Cuewise" description="Your feature request reached us.">
  <meta name="robots" content="noindex" slot="head" />
  <main>
    <section class="page-hero">
      <div class="wrap">
        <h1>Got it — thank you.</h1>
        <p class="hero-sub">
          Requests like yours are what the roadmap gets built from. If you left an email, you may
          hear back with a question.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/feedback/">Send another</a>
          <a class="btn btn-ghost" href={SITE.githubDiscussionsUrl} target="_blank" rel="noopener noreferrer">
            Discuss it publicly on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

