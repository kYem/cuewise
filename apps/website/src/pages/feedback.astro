---
import Base from '../layouts/Base.astro';
import { FEEDBACK_AREAS } from '../lib/feedback-areas';
import { SITE } from '../lib/site';
---

<Base
  title="Request a feature - Cuewise"
  description="Tell us what Cuewise should do next. No account needed."
>
  <meta name="robots" content="noindex" slot="head" />
  <main>
    <section class="page-hero">
      <div class="wrap">
        <h1>What should Cuewise do next?</h1>
        <p class="hero-sub">
          No account, no sign-up — one field and you're done. Every request is read by the person
          who builds it.
        </p>
      </div>
    </section>

    <section class="section-pad" style="padding-top:0;">
      <div class="wrap">
        <div class="content-card glass reveal" id="request-card">
          <form id="request-form" action="/api/feedback/request" method="post">
            <h2>What part of Cuewise?</h2>
            <div class="area-list">
              {
                FEEDBACK_AREAS.map((a) => (
                  <label class="area-option">
                    <input type="radio" name="area" value={a.value} required />
                    <span>{a.label}</span>
                  </label>
                ))
              }
            </div>

            <label class="details-label" for="details">What would you like it to do?</label>
            <textarea
              id="details"
              name="details"
              maxlength="2000"
              rows="5"
              required
              placeholder="The more specific the better — what you were trying to do, and what got in the way."
            ></textarea>

            <label class="details-label" for="email">
              Email <span class="optional">(optional)</span>
            </label>
            <p class="field-hint">
              Only used to ask a follow-up question about this request. Leave it blank and the
              request stays anonymous.
            </p>
            <input id="email" type="email" name="email" maxlength="254" placeholder="you@example.com" />

            <input
              type="text"
              name="trap"
              tabindex="-1"
              autocomplete="off"
              class="hp-field"
              aria-hidden="true"
            />
            <button class="btn btn-primary" type="submit" id="submit-btn">Send request</button>
            <p class="form-error text-error" id="form-error" role="status" aria-live="polite" hidden>
              Couldn't send — please email us instead at
              <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.
            </p>
          </form>

          <div id="thanks" role="status" aria-live="polite" hidden>
            <h2>Got it — thank you.</h2>
            <p>
              Requests like yours are what the roadmap gets built from. If you left an email, you
              may hear back with a question.
            </p>
            <div class="thanks-links">
              <a
                class="btn btn-ghost"
                href={SITE.githubDiscussionsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Discuss it publicly on GitHub
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Static file (not Astro-bundled) so CSP script-src stays 'self' with no hashes. -->
    <script src="/scripts/feedback-form.js" is:inline></script>
  </main>
</Base>

<style>
  .area-list {
    display: grid;
    gap: 10px;
    margin: 18px 0 22px;
  }
  .area-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--glass-hairline);
    border-radius: 12px;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .area-option:hover {
    border-color: rgba(139, 92, 246, 0.6);
  }
  .area-option:has(input:checked) {
    border-color: #8b5cf6;
    background: rgba(139, 92, 246, 0.08);
  }
  .details-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
  }
  .optional {
    opacity: 0.6;
    font-weight: 400;
  }
  .field-hint {
    margin: 0 0 8px;
    font-size: 0.875rem;
    opacity: 0.7;
  }
  textarea,
  input[type='email'] {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--glass-hairline);
    border-radius: 12px;
    background: transparent;
    color: inherit;
    font: inherit;
    margin-bottom: 18px;
    resize: vertical;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    height: 0;
    width: 0;
    opacity: 0;
  }
  .form-error {
    margin-top: 12px;
  }
  .thanks-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
</style>
