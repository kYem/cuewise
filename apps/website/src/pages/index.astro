---
import FinalCta from '../components/FinalCta.astro';
import FitCheck from '../components/home/FitCheck.astro';
import Inside from '../components/home/Inside.astro';
import PrivacyRow from '../components/home/PrivacyRow.astro';
import Stage from '../components/home/Stage.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': SITE.url,
  name: 'Cuewise',
  operatingSystem: 'Chrome, Edge (Chromium browsers)',
  applicationCategory: 'BrowserApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: SITE.url,
  installUrl: SITE.storeUrl,
  description: SITE.defaultDescription,
}).replace(/</g, '\\u003c');
---

<Base title="Cuewise — Turn every new tab into a meaningful moment">
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <main>
    <Stage />
    <Inside />
    <PrivacyRow />
    <FitCheck />
    <FinalCta />
  </main>
</Base>
