---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  label: string;
}

// The frame is half of the 1180px wrap minus the 56px gap above 900px, and full
// width below it — so no viewport ever renders the 1826px source at 1x.
const WIDTHS = [420, 560, 780, 1080, 1440];
const SIZES = '(max-width: 900px) calc(100vw - 48px), 538px';

const { src, alt, label } = Astro.props;
---

<div class="browser">
  <div class="browser-bar">
    <div class="dots"><span class="r"></span><span class="y"></span><span class="g"></span></div>
    <div class="url">{label}</div>
  </div>
  <Image src={src} alt={alt} widths={WIDTHS} sizes={SIZES} format="webp" loading="lazy" />
</div>
