{
  "name": "@cuewise/api",
  "version": "0.3.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:prod": "wrangler deploy --var PUBLIC_BASE_URL:https://api.cuewise.app",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-roundtrip.mjs",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@cuewise/crypto": "workspace:*",
    "@cuewise/shared": "workspace:*",
    "hono": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
